wget ftp://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_48/gencode.v48.annotation.gtf.gz
gunzip gencode.v48.annotation.gtf.gz

# In there, GRCh38.primary_assembly.genome.fa → genome FASTA and gencode.v48.annotation.gtf → GTF annotation for rMATS
nano AGR2_custom.gtf

# Paste both isoforms
# paste the gtf of AGR2-202L and AGR-202S in gtf file
cat AGR2_custom.gtf >> gencode.v48.annotation.gtf

