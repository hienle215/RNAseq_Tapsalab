###--------------------------------prepare for hisat2 annotation in LINUX---------------------------------------------------------------------
custom_transcripts.fa ---> transcriptome FASTA
in rMATS, you typically need: Genome FASTA and Annotation GTF

Step1: Prepare genomce and annotation by downloading from GENCODE v48
# Genome (GRCh38)
wget ftp://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_48/GRCh38.primary_assembly.genome.fa.gz
gunzip GRCh38.primary_assembly.genome.fa.gz

# Annotation
wget ftp://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_48/gencode.v48.annotation.gtf.gz
gunzip gencode.v48.annotation.gtf.gz

# In there, GRCh38.primary_assembly.genome.fa → genome FASTA and gencode.v48.annotation.gtf → GTF annotation for rMATS
nano AGR2_custom.gtf

# Paste both isoforms
# paste the gtf of AGR2-202L and AGR-202S in gtf file
cat AGR2_custom.gtf >> gencode.v48.annotation.gtf

###-------------------------------------------making hisat2 index-----------------------------------------------------------------------------------------------------------------------------------
#---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#!/bin/bash
#SBATCH --job-name=hisat2-index
#SBATCH --output=hisat2_index_%j.out
#SBATCH --error=hisat2_index_%j.err
#SBATCH --cpus-per-task=8
#SBATCH --mem=128G
#SBATCH --time=02:00:00
#SBATCH --partition=large
#SBATCH --constraint=skylake
#SBATCH --mail-type=END
#SBATCH --mail-user=hien.le@tuni.fi

#-----------------------------------
# Load environment
#-----------------------------------
conda init
module purge
source ~/.bashrc
conda activate rmats_env

#-----------------------------------
# Threads
#-----------------------------------
THREADS=${SLURM_CPUS_PER_TASK:-8}

#-----------------------------------
# Paths
#-----------------------------------
ANNOT_DIR="/scratch/svc_td_mbpcg/projects/HanaL/cell_line_del/rMATS"
cd "$ANNOT_DIR" || { echo "ERROR: $ANNOT_DIR not found!"; exit 1; }

#-----------------------------------
# Input files (GENOME, not transcripts!)
#-----------------------------------
GENOME_FA="GRCh38.primary_assembly.genome.fa"
GTF="gencode.v48.annotation.gtf"

# Check files
if [ ! -f "$GENOME_FA" ]; then
    echo "ERROR: $GENOME_FA not found!"
    exit 1
fi

if [ ! -f "$GTF" ]; then
    echo "ERROR: $GTF not found!"
    exit 1
fi

#-----------------------------------
# Step 1: Extract splice info
#-----------------------------------
echo "Extracting splice sites and exons..."

hisat2_extract_splice_sites.py gencode.v48.annotation.gtf > splicesites.txt
hisat2_extract_exons.py gencode.v48.annotation.gtf > exons.txt

#-----------------------------------
# Step 2: Build HISAT2 index
#-----------------------------------
INDEX_PREFIX="genome_index"

echo "Building HISAT2 index with $THREADS threads..."

hisat2-build -p 8 GRCh38.primary_assembly.genome.fa genome_index

#-----------------------------------
# Step 3: Verify index
#-----------------------------------
if ls ${INDEX_PREFIX}*.ht2 1> /dev/null 2>&1; then
    echo "========================================"
    echo "HISAT2 index successfully created:"
    ls -lh ${INDEX_PREFIX}*.ht2
    echo "========================================"
else
    echo "ERROR: HISAT2 index creation failed!"
    exit 1
fi

echo "Job completed at $(date)"

###----------------------------------------------------------sam-to-bam---------------------------------------------------------------------------
###------------------------------------------------------------------------------------------------------------------------------------------------
#!/bin/bash -l
#SBATCH -J sam2bam
#SBATCH --partition=small
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=05:00:00
#SBATCH --array=1-9

set -euo pipefail

SAM_DIR="/scratch/svc_td_mbpcg/projects/HanaL/cell_line_del/rMATS/sam"
OUT_DIR="${SAM_DIR}/bam"

mkdir -p "$OUT_DIR"

module purge
source ~/.bashrc
conda activate rmats_env
module load bio/SAMtools/1.19.2-GCC-13.2.0

THREADS=${SLURM_CPUS_PER_TASK:-8}

mapfile -t SAM_FILES < <(find "$SAM_DIR" -name "*.sam" | sort)

SAM=${SAM_FILES[$((SLURM_ARRAY_TASK_ID - 1))]}
SAMPLE=$(basename "$SAM" .sam)

echo "Processing $SAMPLE"

samtools sort -@ "$THREADS" -o "$OUT_DIR/${SAMPLE}.sorted.bam" "$SAM"
samtools index "$OUT_DIR/${SAMPLE}.sorted.bam"

echo "Done: $SAMPLE"
