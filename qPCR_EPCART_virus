###----------------------------------------------Load sample for far---------------------------------------------------------------------------------
library(dplyr)
library(tidyr)
library(ggplot2)

data2 <- data.frame(
  group = c(
    "Luc_2_K", "Luc_2_Dox_K",
    "EPCART_far_1_K", "EPCART_far_1_Dox_K",
    "EPCART_far_2_K", "EPCART_far_2_Dox_K"
  ),
  V1 = c(0.840339967, 0.969277787, 11.27631128, 29.14, 11.96738906, 22.72996602),
  V2 = c(0.981131081, 0.91298967, 12.36358763, 29.37, 11.74135718, 23.81505513),
  V3 = c(1.212880313, 0.928447035, 11.33673331, 27.64, 11.14697848, 23.58846904)
)

# Trim group names
data2$group <- trimws(data2$group)

# Convert to long format
data_long2 <- data2 %>%
  pivot_longer(cols = V1:V3, names_to = "replicate", values_to = "value") %>%
  mutate(
    # Clean pair names
    pair = case_when(
      grepl("Luc", group) ~ "Luc",
      grepl("far_1", group) ~ "EPCART_far_1",
      grepl("far_2", group) ~ "EPCART_far_2"
    ),
    treatment = ifelse(grepl("Dox", group), "Dox_K", "K")
  )

# Make pair and treatment factors for proper ordering
data_long2 <- data_long2 %>%
  mutate(
    pair = factor(pair, levels = c("Luc", "EPCART_far_1", "EPCART_far_2")),
    treatment = factor(treatment, levels = c("K", "Dox_K"))
  )

# Summarize
summary_data2 <- data_long2 %>%
  group_by(pair, treatment) %>%
  summarise(
    mean = mean(value),
    sd = sd(value),
    .groups = "drop"
  )

# P-values
p_values2 <- data.frame(
  pair = c("Luc", "EPCART_far_1", "EPCART_far_2"),
  p = c(0.45, 0.03, 0.02)
)

# Convert pair to factor in p-values
p_values2$pair <- factor(p_values2$pair, levels = c("Luc", "EPCART_far_1", "EPCART_far_2"))

# Plot
dodge_width <- 0.6
far = ggplot(summary_data2, aes(x = pair, y = mean, fill = treatment)) +
  geom_bar(stat = "identity", position = position_dodge(width = dodge_width), width = 0.5, color = "black") +
  geom_errorbar(aes(ymin = mean - sd, ymax = mean + sd),
                width = 0.2,
                position = position_dodge(width = dodge_width)) +
  geom_jitter(data = data_long2, aes(x = pair, y = value, color = treatment),
              position = position_jitterdodge(jitter.width = 0.15, dodge.width = dodge_width),
              size = 2, inherit.aes = FALSE) +
  geom_text(data = p_values2,
            aes(x = pair, y = max(summary_data2$mean + summary_data2$sd) + 2,
                label = paste0("p = ", p)),
            inherit.aes = FALSE, vjust = 0) +
  scale_fill_manual(values = c("K" = "skyblue", "Dox_K" = "orange")) +
  scale_color_manual(values = c("K" = "skyblue", "Dox_K" = "orange")) +
  labs(y = "Value", x = "Group", fill = "Treatment", color = "Treatment") +
  theme_classic()
ggexport(far,filename = "EPCART_far_virus_LNCap.tiff",
         width = 2500, # 7 inch max width 2100
         height = 1800, 
         res = 300)
