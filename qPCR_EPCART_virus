# Prepare the data
library(ggplot2)
library(dplyr)

# Prepare the data
data1 <- data.frame(
  pair = rep(c(" Luc", "EPCART_near"), each = 6),
  treatment = rep(c(" K", "Dox_K"), times = 3),
  value = c(
    0.840339967, 0.981131081, 1.212880313, 0.969277787, 0.91298967, 0.928447035,
    54.62, 41.77, 51.28, 144.959905, 127.7835163, 116.9212726
  )
)

# Summarize
summary_data1 <- data1 %>%
  group_by(pair, treatment) %>%
  summarise(
    mean = mean(value),
    se = sd(value)/sqrt(n()),
    .groups = "drop"
  )

# Example p-values
p_values1 <- data.frame(
  pair = c(" Luc", "EPCART_near"),
  treatment1 = c(" K", " K"),
  treatment2 = c("Dox_K", "Dox_K"),
  p = c(0.45, 0.03)
)

# Define dodge width
dodge_width <- 0.7

# Plot
near = ggplot(summary_data1, aes(x = pair, y = mean, fill = treatment)) +
  geom_bar(stat = "identity", position = position_dodge(width = dodge_width), width = 0.6, color="black") +
  geom_errorbar(aes(ymin = mean - se, ymax = mean + se),
                width = 0.2,
                position = position_dodge(width = dodge_width)) +
  theme_minimal() +
  labs(y = "Fold change", x = "Group") +
  scale_fill_manual(values = c("skyblue", "orange")) +
  # p-values above bars
  geom_text(data = p_values1,
            aes(x = pair, y = max(summary_data1$mean) + 10, 
                label = paste0("p = ", p)),
            inherit.aes = FALSE, vjust = 0, 
            position = position_dodge(width = dodge_width)) + theme_classic()
