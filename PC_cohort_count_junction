###1.	I have done these with GraphPad, but I think Mina has used R. So she probably can help you more, if you need help. I performed the analysis by placing the progression free months on the X axis and grouping the samples on the Y axis into two categories based on expression levels: low expression and high expression. Instead of using the expression values, put the Progression values (0 or 1) there instead.

library(dplyr); library(survival); library(survminer); library(ggpubr)

km_data <- clinical_data %>% select(`Progression (0=no, 1=yes)`, progression_free_months, CPM_AGR2_202S, CPM_AGR2_202L, CPM_AGR2_203) %>% na.omit() %>% rename(Progression=`Progression (0=no, 1=yes)`)

make_KM_plot <- function(data,gene,gene_label){

cutoff <- median(data[[gene]],na.rm=TRUE)

data$Expression <- ifelse(data[[gene]]>cutoff,"High expression (> median)","Low expression (< median)")

data$Expression <- factor(data$Expression,levels=c("Low expression (< median)","High expression (> median)"))

fit <- survfit(Surv(progression_free_months,Progression)~Expression,data=data)

ggsurvplot(fit,
data=data,
pval=TRUE,
risk.table=FALSE,
conf.int=FALSE,
palette=c("blue","red"),
legend.title=gene_label,
legend.labs=c("Low expression (< median)","High expression (> median)"),
legend=c(0.75,0.85),
title=paste0(gene_label," progression-free survival"),
xlab="Progression-free survival (months)",
ylab="Survival probability",
ggtheme=theme_classic(base_size=14))
}

KM_202S <- make_KM_plot(km_data,"CPM_AGR2_202S","AGR2-202S")
KM_202L <- make_KM_plot(km_data,"CPM_AGR2_202L","AGR2-202L")
KM_203 <- make_KM_plot(km_data,"CPM_AGR2_203","AGR2-203")

KM_202S; KM_202L; KM_203

final_KM <- ggarrange(KM_202S$plot,KM_202L$plot,KM_203$plot,labels=c("A","B","C"),ncol=3)

final_KM

ggexport(final_KM,filename="AGR2_KM_clean_legend.tiff",width=300,height=120,units="mm",dpi=600)

