# ==============================
# Libraries
# ==============================
library(DESeq2)
library(dplyr)
library(tibble)
library(tidyr)
library(ggplot2)

# ==============================
# 1. Sample and condition setup
# ==============================
samples <- c(
  "LN_0_1","LN_0_2","LN_0_3",
  "LN_10_1","LN_10_2","LN_10_3",
  "LN_AR_1","LN_AR_2","LN_AR_3",
  "LN_NC_1","LN_NC_2","LN_NC_3"
)

conditions <- c(
  rep("LN_0", 3),
  rep("LN_10", 3),
  rep("LN_AR", 3),
  rep("LN_NC", 3)
)

coldata <- data.frame(
  row.names = samples,
  condition = factor(conditions, levels = c("LN_NC","LN_AR","LN_10","LN_0"))
)

base_dir <- "C:/Users/leh/OneDrive - TUNI.fi/Documents/Data/output_AGR2long"

# ==============================
# 2. Read kallisto abundance.tsv
# ==============================
counts_list <- list()
tpm_list    <- list()

for (s in samples) {
  df <- read.delim(file.path(base_dir, s, "abundance.tsv"),
                   stringsAsFactors = FALSE)
  
  if (!exists("transcripts")) {
    transcripts <- df$target_id
  }
  
  counts_list[[s]] <- round(df$est_counts)
  tpm_list[[s]]    <- df$tpm
}

counts <- do.call(cbind, counts_list)
tpm    <- do.call(cbind, tpm_list)

rownames(counts) <- transcripts
rownames(tpm)    <- transcripts
colnames(counts) <- samples
colnames(tpm)    <- samples

# ==============================
# 2b. Add AGR2-202S manually
# ==============================
agr2_202S_counts <- round(c(69.9635, 41.4892, 56.0043, 89.6087, 99.0224, 101.025, 
                            4, 16.4677, 28, 5, 29.1092, 28.9505))

agr2_202S_tpm <- round(c(15.0819, 8.3965, 9.43805, 16.4925, 17.7481, 17.4822,
                         0.748161, 2.6301, 4.46211, 0.950508, 5.52126, 4.35274))

agr2_202S_name <- "custom-202short|AGR2|202S|...|..."  # must contain "custom-202short"

counts <- rbind(counts, agr2_202S_counts)
tpm    <- rbind(tpm, agr2_202S_tpm)

rownames(counts)[nrow(counts)] <- agr2_202S_name
rownames(tpm)[nrow(tpm)]    <- agr2_202S_name

# ==============================
# 3. DESeq2
# ==============================
dds <- DESeqDataSetFromMatrix(
  countData = counts,
  colData   = coldata,
  design    = ~ condition
)

dds <- DESeq(dds)
norm_counts <- counts(dds, normalized = TRUE)

# ==============================
# 4. AGR2 transcript → variant mapping
# ==============================
agr2_ids <- rownames(norm_counts)[grepl("\\|AGR2\\|", rownames(norm_counts))]

agr2_variant_map <- tibble(
  transcript = agr2_ids,
  variant = case_when(
    grepl("custom-202short", transcript) ~ "AGR2-202S",
    grepl("\\|AGR2-202\\|", transcript)  ~ "AGR2-202L",
    grepl("\\|AGR2-203\\|", transcript)  ~ "AGR2-203"
  )
) %>% filter(!is.na(variant))

# ==============================
# 5. Long-format normalized counts
# ==============================
agr2_df <- norm_counts[agr2_variant_map$transcript, , drop = FALSE] %>%
  as.data.frame() %>%
  rownames_to_column("transcript") %>%
  left_join(agr2_variant_map, by = "transcript") %>%
  pivot_longer(
    cols = -c(transcript, variant),
    names_to = "sample",
    values_to = "expr"
  ) %>%
  left_join(
    coldata %>% rownames_to_column("sample"),
    by = "sample"
  ) %>%
  mutate(
    condition = factor(condition, levels = c("LN_NC","LN_AR","LN_10","LN_0")),
    variant   = factor(variant, levels = c("AGR2-202L","AGR2-202S","AGR2-203"))
  )

# ==============================
# 6. Summary stats (bar heights)
# ==============================
agr2_summary <- agr2_df %>%
  group_by(condition, variant) %>%
  summarise(
    mean_expr = mean(expr),
    sd_expr   = sd(expr),
    max_expr  = max(expr),
    .groups = "drop"
  )

# ==============================
# 7. DESeq2 p-values
# ==============================
res_AR  <- results(dds, contrast = c("condition","LN_AR","LN_NC"))
res_10  <- results(dds, contrast = c("condition","LN_10","LN_NC"))
res_0   <- results(dds, contrast = c("condition","LN_0","LN_NC"))  # <-- add this

pvals <- bind_rows(
  tibble(
    transcript = agr2_variant_map$transcript,
    condition  = "LN_AR",
    padj       = res_AR[agr2_variant_map$transcript, "padj"]
  ),
  tibble(
    transcript = agr2_variant_map$transcript,
    condition  = "LN_10",
    padj       = res_10[agr2_variant_map$transcript, "padj"]
  ),
  tibble(
    transcript = agr2_variant_map$transcript,
    condition  = "LN_0",
    padj       = res_0[agr2_variant_map$transcript, "padj"]
  )
) %>%
  left_join(agr2_variant_map, by = "transcript") %>%
  group_by(condition, variant) %>%
  summarise(
    padj = min(padj, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  left_join(agr2_summary, by = c("condition","variant")) %>%
  mutate(
    label = case_when(
      padj < 0.001 ~ "***",
      padj < 0.01  ~ "**",
      padj < 0.05  ~ "*",
      TRUE ~ "ns"
    ),
    y.position = max_expr * 1.1
  )

# ==============================
# 8. Plot function (soft red, green, blue, yellow)
# ==============================
make_agr2_plot <- function(v) {
  ggplot(
    agr2_summary %>% filter(variant == v),
    aes(x = condition, y = mean_expr, fill = condition)
  ) +
    geom_bar(stat = "identity", width = 0.6, alpha = 0.85) +
    geom_errorbar(
      aes(ymin = mean_expr - sd_expr,
          ymax = mean_expr + sd_expr),
      width = 0.2
    ) +
    geom_jitter(
      data = agr2_df %>% filter(variant == v),
      aes(x = condition, y = expr),
      width = 0.1,
      size = 2
    ) +
    geom_text(
      data = pvals %>% filter(variant == v),
      aes(x = condition, y = y.position, label = label),
      inherit.aes = FALSE,
      size = 5
    ) +
    scale_fill_manual(
      values = c(
        "LN_NC" = "#FF9999",  # soft red
        "LN_AR" = "#99CC99",  # soft green
        "LN_10" = "#99CCFF",  # soft blue
        "LN_0"  = "#FFCC99"   # soft yellow
      )
    ) +
    theme_classic(base_size = 10) +
    labs(
      y = "Normalized counts",
      x = "Condition",
      title = paste("AGR2 expression:", v)
    )
}

# ==============================
# 9. Generate plots
# ==============================
p_202L <- make_agr2_plot("AGR2-202L")
p_202S <- make_agr2_plot("AGR2-202S")
p_203  <- make_agr2_plot("AGR2-203")

# Display plots
p_202L
p_202S
p_203


