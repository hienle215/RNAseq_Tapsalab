# 1. Start with original GENCODE FASTA
zcat gencode.v48.transcripts.fa.gz > gencode_v48.fa
grep -v "ENST00000412973" gencode_v48.fa > gencode_v48_noAGR2.fa

# 2. Append modified short transcript (with unique tag)
cat AGR2-202-short.fa >> gencode_v48_noAGR2.fa

# 3. Build new Kallisto index with bash
module load bio/kallisto/0.51.1-gompi-2023b
kallisto index -i gencode_v48_noAGR2.idx gencode_v48_noAGR2.fa

# 4. Quantify your samples
kallisto quant -i gencode_v48_with_short.idx -o output sample_R1.fastq.gz sample_R2.fastq.gz

