#!/bin/bash -l
#SBATCH -J hisat2_align
#SBATCH --partition=small
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=12:00:00
#SBATCH --array=1-15   # total number of replicates
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=hien.le@tuni.fi

set -euo pipefail

#------------------------- Paths -------------------------#
FASTQ_DIR="/scratch/svc_td_mbpcg/projects/HanaL/cell_line_del"
OUT_DIR="/scratch/svc_td_mbpcg/projects/HanaL/cell_line_del/rMATS/bam"
INDEX="/scratch/svc_td_mbpcg/projects/HanaL/cell_line_del/rMATS/genome_index/genome_index"

mkdir -p "${OUT_DIR}"

#------------------------- Environment -------------------#
module purge
conda activate rmats_env
THREADS=${SLURM_CPUS_PER_TASK:-8}

#------------------------- List all replicates ----------------#
# Find all _1.fq.gz files
mapfile -t ALL_R1 < <(find "${FASTQ_DIR}" -name "*_1.fq.gz" | sort)

# Extract unique replicate names (basename without _1.fq.gz)
REPLICATES=()
for f in "${ALL_R1[@]}"; do
    base=$(basename "$f" _1.fq.gz)
    REPLICATES+=("$base")
done

NUM_REPLICATES=${#REPLICATES[@]}
IDX=$((SLURM_ARRAY_TASK_ID - 1))

if [[ $IDX -ge $NUM_REPLICATES ]]; then
    echo "ERROR: Array task ID out of range"
    exit 1
fi

SAMPLE=${REPLICATES[$IDX]}
R1="${FASTQ_DIR}/${SAMPLE}_1.fq.gz"
R2="${FASTQ_DIR}/${SAMPLE}_2.fq.gz"
PREFIX="${OUT_DIR}/${SAMPLE}"

#------------------------- Verify files ------------------#
[[ -f "${R1}" ]] || { echo "ERROR: R1 missing: $R1"; exit 1; }
[[ -f "${R2}" ]] || { echo "ERROR: R2 missing: $R2"; exit 1; }
[[ -f "${INDEX}.1.ht2" ]] || { echo "ERROR: HISAT2 index missing"; exit 1; }

#------------------------- Run HISAT2 -------------------#
echo "Aligning replicate: ${SAMPLE}"
echo "R1: $R1"
echo "R2: $R2"
echo "Output: ${PREFIX}.sorted.bam"

hisat2 -x "${INDEX}" -1 "${R1}" -2 "${R2}" --dta -p "${THREADS}" -S "${PREFIX}.sam"

samtools view -@ "${THREADS}" -bS "${PREFIX}.sam" \
    | samtools sort -@ "${THREADS}" -o "${PREFIX}.sorted.bam"

samtools index "${PREFIX}.sorted.bam"
rm "${PREFIX}.sam"

echo "Done: ${SAMPLE}"
