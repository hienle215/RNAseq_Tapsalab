#!/bin/bash -l

#SBATCH -J SRA_to_FASTQ
#SBATCH --partition=small
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem-per-cpu=4G
#SBATCH --time=40:00:00
#SBATCH --constraint=skylake
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=hien.le@tuni.fi

set -euo pipefail


#------------------------- Paths -------------------------#

BASE_DIR="/scratch/svc_td_mbpcg/projects/HanaL/organoids"

SRA_DIR="${BASE_DIR}/sra"
FASTQ_DIR="${BASE_DIR}/fastq_output"
TMP_DIR="${BASE_DIR}/tmp"
LOG_DIR="${BASE_DIR}/logs"

mkdir -p "$FASTQ_DIR" "$TMP_DIR" "$LOG_DIR"


#------------------------- Tools -------------------------#

export PATH="$PATH:/scratch/svc_td_mbpcg/projects/HanaL/organoids/sratoolkit.3.4.1-ubuntu64/bin"

echo "Using:"
which fasterq-dump
fasterq-dump --version


#------------------------- SRA IDs -------------------------#

SAMPLES=(
SRR18026994
SRR15335220
SRR15335221
SRR15335222
SRR15335223
SRR15335224
SRR15335225
SRR15335226
SRR15335227
SRR15335228
SRR15335229
SRR15335230
SRR15335231
SRR15335232
SRR15335233
SRR15335234
SRR15335235
SRR15335236
SRR15335237
SRR15335238
SRR15335239
SRR15335240
SRR15335241
SRR18026985
SRR18026986
SRR18026987
SRR18026988
SRR18026989
SRR18026990
SRR18026992
SRR18026993
SRR18026995
SRR18026996
)


#------------------------- Convert SRA to FASTQ -------------------------#

echo "Starting FASTQ conversion..."

for SAMPLE in "${SAMPLES[@]}"
do
    echo "Converting ${SAMPLE}"

    fasterq-dump \
        "${SRA_DIR}/${SAMPLE}/${SAMPLE}.sra" \
        --split-files \
        --threads 8 \
        --temp "$TMP_DIR" \
        --outdir "$FASTQ_DIR"

done


#------------------------- Compress FASTQ -------------------------#

echo "Compressing FASTQ files..."

for FILE in "${FASTQ_DIR}"/*.fastq
do
    gzip "$FILE"
done


#------------------------- Summary -------------------------#

echo ""
echo "=========================================="
echo "FASTQ conversion and compression complete"
echo "FASTQ output:"
ls -lh "$FASTQ_DIR"
echo "=========================================="
