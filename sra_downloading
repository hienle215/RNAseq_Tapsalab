#!/bin/bash -l
#SBATCH -J SRA_downloading
#SBATCH --partition=small
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem-per-cpu=4G
#SBATCH --time=24:00:00
#SBATCH --constraint=skylake
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=hien.le@tuni.fi

set -euo pipefail

#------------------------- Paths -------------------------#
PROJECT_DIR="/scratch/svc_td_mbpcg/projects/HanaL/organoids"
OUTPUT_DIR="${PROJECT_DIR}/fastq_output"
TMP_DIR="${PROJECT_DIR}/tmp"
SRATOOLKIT_BIN="${PROJECT_DIR}/sratoolkit.3.4.1-ubuntu64/bin"

cd "${PROJECT_DIR}"
mkdir -p "${OUTPUT_DIR}" "${TMP_DIR}"

export PATH=$PATH:${SRATOOLKIT_BIN}
which prefetch
which fasterq-dump

#------------------------- SRR list -----------------------#
SRR_LIST=(
  SRR18026994
  SRR15335220
  SRR15335221
  SRR15335222
  SRR15335223
  SRR15335224
  SRR15335225
  SRR15335226
  SRR15335227
  SRR15335228
  SRR15335229
  SRR15335230
  SRR15335231
  SRR15335232
  SRR15335233
  SRR15335234
  SRR15335235
  SRR15335236
  SRR15335237
  SRR15335238
  SRR15335239
  SRR15335240
  SRR15335241
  SRR18026985
  SRR18026986
  SRR18026987
  SRR18026988
  SRR18026989
  SRR18026990
  SRR18026992
  SRR18026993
  SRR18026995
  SRR18026996
)

#------------------------- Downloading -----------------------#
for SRR in "${SRR_LIST[@]}"; do
  echo "=== Prefetching ${SRR} ==="
  prefetch "${SRR}" --output-directory "${PROJECT_DIR}"
done

#------------------------- Converting -----------------------#
for SRR in "${SRR_LIST[@]}"; do
  echo "=== Converting ${SRR} to FASTQ ==="
  fasterq-dump "${SRR}" \
    --split-files \
    -O "${OUTPUT_DIR}" \
    -e 8 \
    -t "${TMP_DIR}"
done

#------------------------- Done -----------------------#
echo ""
echo "=========================================="
echo "All downloads and conversions complete!"
echo "Output saved in: ${OUTPUT_DIR}"
echo "Output files:"
ls -lh "${OUTPUT_DIR}"
echo "=========================================="
