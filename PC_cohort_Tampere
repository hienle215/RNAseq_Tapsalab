###---------------------------------------------------------------Multivariate Cox regression for AGR2-203---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
# ============================
# Load libraries
# ============================
library(dplyr)
library(survival)
library(survminer)

# ============================
# 1. AGR2-203 High / Low (median split)
# ============================
merged_data <- merged_data %>%
  mutate(
    AGR2_203_log_group = ifelse(
      `AGR2-203` > median(`AGR2-203`, na.rm = TRUE),
      "High", "Low"
    )
  )

# ============================
# 2. PSA groups (CORRECT — no na_if, no as.numeric)
# ============================
merged_data <- merged_data %>%
  mutate(
    PSA_group = cut(
      PSA_at_progression,
      breaks = c(-Inf, 10, 19.9, Inf),
      labels = c("≤10", "10–19.9", "≥20")
    )
  )

# ============================
# 3. Gleason groups (CORRECT)
# ============================
merged_data <- merged_data %>%
  mutate(
    Gleason_group = cut(
      Gleason_score,
      breaks = c(-Inf, 6, 7, Inf),
      labels = c("<7", "7", ">7")
    )
  )

# ============================
# 4. pT as factor
# ============================
merged_data$pT <- as.factor(merged_data$pT)

# ============================
# 5. Prepare KM dataset
# ============================
km_data <- merged_data %>%
  filter(
    !is.na(AGR2_203_log_group),
    !is.na(progression_free_months),
    !is.na(`Progression (0=no, 1=yes)`)
  )

# ============================
# 6. Survival object
# ============================
surv_obj <- Surv(
  time  = km_data$progression_free_months,
  event = km_data$`Progression (0=no, 1=yes)`
)

# ============================
# 7. Kaplan–Meier fit
# ============================
fit <- survfit(
  surv_obj ~ AGR2_203_log_group,
  data = km_data
)

# ============================
# 8. Kaplan–Meier plot
# ============================
km_plot <- ggsurvplot(
  fit,
  data = km_data,
  pval = TRUE,
  risk.table = TRUE,
  surv.median.line = "hv",
  palette = c("blue", "red"),
  xlab = "Progression-Free Months",
  ylab = "Progression-Free Survival Probability",
  legend.title = "AGR2-203",
  legend.labs = c("Low", "High")
)

print(km_plot)

# ============================
# 9. Multivariate Cox regression
# ============================
cox_model <- coxph(
  Surv(progression_free_months, `Progression (0=no, 1=yes)`) ~
    AGR2_203_log_group +
    Age_at_diagnosis +
    PSA_group +
    Gleason_group +
    pT,
  data = merged_data
)

summary(cox_model)

# ============================
# 10. Forest plot
# ============================
forest_plot <- ggforest(
  cox_model,
  data = merged_data,
  main = "Multivariate Cox regression for AGR2-203",
  cpositions = c(0.02, 0.22, 0.4),
  fontsize = 1,
  refLabel = "Reference"
)

print(forest_plot)

# ============================
# 11. Export forest plot
# ============================
ggexport(
  forest_plot,
  filename = "Cox_analysis_AGR2_203_PCcohort.tiff",
  width = 3200,
  height = 2500,
  res = 300
)


