# 
# 7️⃣ Kaplan-Meier Plots
# 
# Function to create KM plot for a given transcript
plot_KM <- function(df, transcript, cutoff="median") {
  expr <- df[[transcript]]
  
  # Define high/low groups
  if(cutoff == "median") {
    df$group <- ifelse(expr > median(expr, na.rm = TRUE), "High", "Low")
  } else if(cutoff == "quartile") {
    q <- quantile(expr, probs=c(0.25,0.75), na.rm=TRUE)
    df$group <- ifelse(expr <= q[1], "Low",
                       ifelse(expr >= q[2], "High", NA))
  }
  
  # Surv object
  surv_obj <- Surv(time = df$progression_free_months, event = df$Progression)
  fit <- survfit(surv_obj ~ group, data = df)
  
  # Plot
  ggsurvplot(fit,
             data = df,
             risk.table = TRUE,
             pval = TRUE,
             palette = c("blue", "red"),
             title = paste("Progression-Free Survival:", transcript))
}

